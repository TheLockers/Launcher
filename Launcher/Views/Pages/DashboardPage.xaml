<Page x:Class="Launcher.Views.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Launcher.Views.Pages"
      xmlns:vm="clr-namespace:Launcher.ViewModels"
      xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
      xmlns:components="clr-namespace:Launcher.Views.Components"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      d:Background="Black"
      Style="{StaticResource PageStyle}"
      Title="DashboardPage">

    <Page.DataContext>
        <vm:DashboardViewModel />
    </Page.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="70" />
        </Grid.RowDefinitions>


        <Border Grid.Row="2"  Style="{StaticResource NavigationPanel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition />
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>

                <Button 
                        Width="50" Height="50"
                        ToolTip="Перейти на сайт"
                        Background="Transparent">      
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <Image Source="pack://application:,,,/Views/Resources/Images/Лого.png" 
                               Width="28" Height="28" 
                               Stretch="Uniform"
                               />   
                    </StackPanel>
                </Button>

                <Grid Grid.Column="1"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Center" >
                    <components:ServersListComponent
                        ServersList="{Binding ServersList}"/>
                </Grid>

                <Grid Grid.Column="2"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Center" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{DynamicResource ProfileBorder}" >
                        <Button Style="{DynamicResource ProfileButton}" 
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                            <svgc:SvgViewbox 
                                Source="/Views/Resources/Images/profile_icon.svg" 
                                Height="28" 
                                Width="28"/>
                        </Button>
                    </Border>
                    
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
