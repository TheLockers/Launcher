<UserControl x:Class="Launcher.Views.Components.ServerLoaderComponent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             xmlns:local="clr-namespace:Launcher.Views.Components"
             mc:Ignorable="d" 
             d:DesignHeight="65" d:DesignWidth="260">
    <Border Style="{StaticResource LoaderBorderStyle}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="70"/>
            </Grid.ColumnDefinitions>

            <svgc:SvgViewbox Source="/Views/Resources/Images/downloadiconx64_comp.svg" 
                             Height="32" 
                             Width="32"/>

            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Orientation="Vertical"
                        Grid.Column="1">

                <TextBlock Text="{Binding Title}" 
                           FontSize="12"
                           FontWeight="Medium"
                           Foreground="White"/>
                <TextBlock Text="{Binding Description}" 
                           FontSize="10"
                           Margin="0, 5, 0, 0"
                           FontWeight="Medium"
                           Foreground="#56ffffff"/>

            </StackPanel>
            
            <ProgressBar Value="0.7" Maximum="1"  
                         Grid.Column="2"
                         Height="32" 
                         Width="32" 
                         Style="{DynamicResource RoundProgressBarStyle}"
                         Foreground="#008C45" 
                         Background="#151515"/>
        </Grid>
    </Border>
</UserControl>
