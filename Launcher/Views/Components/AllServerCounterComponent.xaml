<UserControl x:Class="Launcher.Views.Components.AllServerCounterComponent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Launcher.Views.Components" 
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             mc:Ignorable="d" 
             d:DesignHeight="120" d:DesignWidth="300">
    <Border Style="{StaticResource AllCountPlayerStyle}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource PrimaryColor}"
                    Width="44"
                    Height="44"
                    CornerRadius="10">
                <Image Source="C:\Users\polun\source\repos\Launcher\Launcher\Views\Resources\Images\playercount.png"
                   Width="40"
                   Height="40"/>
            </Border>
            

            <StackPanel Orientation="Vertical"
                        VerticalAlignment="Center"
                        Grid.Column="1"
                        Margin="10 0 0 0">
                <TextBlock Text="На серерах: "
                           FontSize="14"
                           Foreground="{StaticResource ContentForegroundColor}"/>
                <TextBlock Margin="0 3 0 0">
                    <Run Text="{Binding PlayerCount}"
                         d:Text="2546"
                         FontWeight="Bold"
                         FontSize="18"
                         Foreground="{StaticResource HeadLineContentForegroundColor}"/>
                    <Run Text="чел."
                         FontSize="14"
                         Foreground="{StaticResource ContentForegroundColor}"/>
                </TextBlock>
            </StackPanel>
                        
        </Grid>
    </Border>
</UserControl>
