<UserControl x:Class="Launcher.Views.Components.AllServerCounterComponent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Launcher.Views.Components" 
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             mc:Ignorable="d" 
             d:DesignHeight="120" d:DesignWidth="300">
    <Border Style="{StaticResource AllCountPlayerStyle}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <svgc:SvgViewbox Source="/Views/Resources/Images/downloadiconx64_comp.svg" 
                             Height="24" 
                             Width="24"/>

            <StackPanel Orientation="Vertical"
                        Grid.Column="1">
                <TextBlock Text="На серерах: "/>
                <TextBlock>
                    <Run Text="{Binding PlayerCount}"
                         
                         d:Text="2546"/>
                    <Run Text="чел."/>
                </TextBlock>
            </StackPanel>
                        
        </Grid>
    </Border>
</UserControl>
