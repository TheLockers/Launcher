<UserControl x:Class="Launcher.Views.Components.AllServerCounterComponent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Launcher.Views.Components" 
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             mc:Ignorable="d" 
             d:DesignHeight="120" d:DesignWidth="300">
    <Border Style="{StaticResource AllCountPlayerStyle}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <svgc:SvgViewbox Source="/Views/Resources/Images/profile_icon.svg" 
                             Height="32" 
                             Width="32"/>

            <StackPanel Orientation="Vertical"
                        VerticalAlignment="Center"
                        Grid.Column="1">
                <TextBlock Text="На серерах: "
                           FontSize="16"
                           Foreground="{StaticResource ContentForegroundColor}"/>
                <TextBlock >
                    <Run Text="{Binding PlayerCount}"
                         d:Text="2546"
                         FontWeight="Bold"
                         FontSize="20"
                         Foreground="{StaticResource HeadLineContentForegroundColor}"/>
                    <Run Text="чел."
                         FontSize="16"
                         Foreground="{StaticResource ContentForegroundColor}"/>
                </TextBlock>
            </StackPanel>
                        
        </Grid>
    </Border>
</UserControl>
